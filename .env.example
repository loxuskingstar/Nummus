# Copier en « .env » puis adapter.
NUMMUS_PORT=8080
# Utilisateur propriétaire de ./data (résultats de `id -u` et `id -g`)
NUMMUS_UID=1000
NUMMUS_GID=1000
# Identifiants HTTP Basic (laisser NUMMUS_PASSWORD vide pour désactiver l'authentification)
NUMMUS_USER=nummus
NUMMUS_PASSWORD=
# Clé API Numista (https://en.numista.com/api/) — facultatif
NUMISTA_API_KEY=
# Sauvegardes automatiques de la base : toutes les N heures si elle a changé (0 = désactivées), N conservées
NUMMUS_BACKUP_EVERY_HOURS=24
NUMMUS_BACKUP_KEEP=7
# Derrière un proxy inverse (Caddy, nginx) : mettre 1 pour que la limite d'essais de mot de passe utilise l'IP réelle
NUMMUS_TRUST_PROXY=
# Copie périodique vers WebDAV (Nextcloud…), faite par le serveur ; utiliser un mot de passe d'application
NUMMUS_WEBDAV_URL=
NUMMUS_WEBDAV_USER=
NUMMUS_WEBDAV_PASSWORD=
NUMMUS_WEBDAV_EVERY_HOURS=24
